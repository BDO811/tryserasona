rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own profile + subscription state. The client may read its
    // own doc and update its own profile fields, but never write `subscription`
    // directly — that field is only ever written by the stripe-webhook Cloud
    // Function, which uses the Admin SDK and bypasses these rules entirely.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !("subscription" in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["email", "fullName"]);
      allow delete: if false;

      // Daily check-in history, owned entirely by the user it belongs to.
      match /checkins/{checkinId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false; // check-ins are append-only
      }
    }

    // Default deny for anything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
